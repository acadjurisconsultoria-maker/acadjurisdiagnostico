# Copie este arquivo para .env.local (desenvolvimento) e preencha os valores reais.
# NUNCA copie valores reais para este arquivo (.env.example fica versionado no Git).
# NUNCA use dado real de cliente em nenhum ambiente que nao seja producao.
#
# Padrao atual de chaves do Supabase (publishable/secret) -- este projeto
# nao usa as chaves legadas (anon/service_role).

# --- Supabase (projeto de DESENVOLVIMENTO -- nunca aponte isto para producao) ---

# URL publica do projeto Supabase. Seguro expor ao navegador.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key do Supabase (substitui a antiga "anon key"). Seguro expor
# ao navegador -- o acesso real e sempre controlado por Row Level Security
# no Postgres, nao por esta chave.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Variaveis exclusivas de servidor (nunca prefixadas com NEXT_PUBLIC_) ---

# Mesma URL do projeto acima, em variavel propria de servidor -- disciplina
# de nomenclatura: codigo de servidor nunca depende do nome prefixado com
# NEXT_PUBLIC_, mesmo essa URL nao sendo secreta.
SUPABASE_URL=

# Secret key do Supabase (substitui a antiga "service_role key"). IGNORA o
# Row Level Security. NUNCA prefixar com NEXT_PUBLIC_. NUNCA importar em
# codigo que roda no navegador. Usada apenas via src/lib/supabase/admin.ts,
# e somente com autorizacao explicita de perfil + operacao.
SUPABASE_SECRET_KEY=

# --- Identificacao do ambiente logico (separado do NODE_ENV do Next.js) ---
# Valores esperados: "development" | "preview" | "production"
# Usado para bloquear, em codigo, qualquer tentativa de usar dado real fora de "production".
APP_ENV=development
